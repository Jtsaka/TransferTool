# Copy this file to .env and fill in real values.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Firebase / Firestore configuration.
# Either provide an absolute path to a service-account JSON file...
FIREBASE_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
# ...or paste the full JSON value (escaped for env files) into this var instead.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account", ...}

# Optional: explicit project id when using application-default creds.
FIREBASE_PROJECT_ID=

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=1
